# Port the app listens on inside the container (also used by docker-compose).
PORT=3000

# Name of the existing Docker network that your cloudflared container is on.
# The tunnel reaches this app by its Docker service name (http://books:3000),
# so books-pwa must join the SAME network as cloudflared.
# Check yours with: docker network ls  /  docker inspect cloudflared
DOCKER_NETWORK=proxy

# Timezone, so "date terminée" / stats-per-year use your local calendar.
TZ=Europe/Paris
